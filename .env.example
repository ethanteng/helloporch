# The same Next.js server serves the website and the native call token endpoint.
# Copy to .env.local. Never expose the API key/secret in NEXT_PUBLIC variables.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Generate with: openssl rand -hex 24
# Share only with prototype testers. This grants access to all prototype rooms.
PORCH_CALL_ACCESS_CODE=

# Optional: phone fallback after the iPad tries Porch for 20 seconds.
# Create an outbound SIP trunk in your LiveKit project with your telephone
# provider's credentials and outgoing caller-ID number. Only its ID goes here.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Optional local operator override for inbound setup when the outbound trunk has
# multiple numbers. The setup script saves the number → household assignment in
# managed Redis; no new public variables or caller-recognition routing are used.
# PORCH_INBOUND_NUMBER=+14155550100
# See ios/INBOUND-PHONE-CALLS.md for Twilio Origination and LiveKit webhooks.
# Generate a different secret with: openssl rand -hex 24
# Server-only signing/recovery secret. Keep it long even when caregivers use a
# six-digit PIN. Existing iPads can migrate this saved secret in Family & drop-in.
# Never share it with ordinary call recipients or put it in the app binary.
PORCH_CONTACT_SETUP_CODE=
# Optional legacy list for older iPad builds. Updated iPads use contact approvals.
# Comma-separated destinations in +country-code format; no upkeep needed after migration.
PORCH_PHONE_NUMBERS=

# Managed Upstash Redis for device pairing, permissions, call signaling and PINs.
# Vercel's integration injects the KV_REST_API_* aliases; either pair is supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local synthetic testing only; never share the production data namespace.
# PORCH_FAMILY_STORE_PREFIX=porch:family:preview:v1:

# Incoming ordinary Porch calls to locked/background family iPhones via APNs.
# Use an Apple Developer APNs signing key (.p8), NOT the App Store Connect key.
# Register Push Notifications for the app ID and regenerate distribution profiles.
APNS_KEY_ID=
APNS_TEAM_ID=7U9T57JPF7
# PEM contents; literal \\n separators are also accepted. Server-only secret.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.ethanteng.helloporch

# Family messages and voicemail: a *private* Vercel Blob store connected to this
# project (Vercel injects the token). Devices only ever get short-lived signed URLs.
BLOB_READ_WRITE_TOKEN=

# Optional: natural bedside announcement voices from ElevenLabs. Server-only secret; use a key
# restricted to Text to Speech, with a credit limit. Clips are kept in the Blob store above, so
# each sentence is paid for once. Without it the bedside uses the iPad's built-in voices.
ELEVENLABS_API_KEY=

# Voicemail from regular phone callers (ios/INBOUND-PHONE-CALLS.md). The Twilio
# number's voice webhook verifies requests with the auth token and fetches each
# recording, then deletes Twilio's copy. Server-only secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The project's SIP URI from LiveKit Cloud → Settings, e.g. sip:abc123.sip.livekit.cloud
LIVEKIT_SIP_URI=

# A Porch number for each household, bought from Twilio during setup (ios/INBOUND-PHONE-CALLS.md).
# Needs the Twilio and SIP settings above. The live HTTPS origin, never a deployment URL: Twilio
# calls its voice webhook for as long as the number exists.
# PORCH_SERVER_ORIGIN=https://porch-calling-prototype.vercel.app
# The most numbers Porch may hold. Without it, Porch buys none.
# PORCH_MAX_PHONE_NUMBERS=5

# The admin page at admin.helloporch.store (ONBOARDING-PLAN.md, phase 2). Set these on the calling project only:
# the website project serves the same code and must answer 404 there. The hash comes from
# `node scripts/admin-password.mjs`; the password itself is never stored. Changing it signs out every session.
# PORCH_ADMIN_ENABLED=1
# PORCH_ADMIN_PASSWORD_HASH=scrypt:32768:8:1:…
